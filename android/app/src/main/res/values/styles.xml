<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/sancheng_paper</item>
        <item name="colorPrimaryDark">@color/sancheng_paper</item>
        <item name="colorAccent">@color/sancheng_red</item>
        <item name="android:windowBackground">@color/sancheng_paper</item>
        <item name="android:statusBarColor">@color/sancheng_paper</item>
        <item name="android:navigationBarColor">@color/sancheng_paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/sancheng_paper</item>
        <item name="android:statusBarColor">@color/sancheng_paper</item>
        <item name="android:navigationBarColor">@color/sancheng_paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/sancheng_paper</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/sancheng_paper</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:statusBarColor">@color/sancheng_paper</item>
        <item name="android:navigationBarColor">@color/sancheng_paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
